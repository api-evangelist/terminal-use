          "id": "ea9ba64e-6a93-4167-97b4-1c3206b943cc",
          "name": "List Messages (v2 - UIMessage format)",
          "request": {
            "name": "List Messages (v2 - UIMessage format)",
            "description": {
              "content": "List messages for a task in Vercel AI SDK UIMessage format.\n\n    This endpoint returns messages transformed from raw SDK events into\n    a normalized UIMessage format suitable for frontend consumption.\n\n    Features:\n    - Tool merging: tool_use and tool_result are combined into single tool parts\n    - Complete-units pagination: Never splits tool request/result pairs across pages\n    - Runtime transformation: Raw SDK messages are transformed on-demand\n\n    Args:\n        task_id: The task ID to filter messages by\n        limit: Maximum number of complete messages to return (default: 50)\n        cursor: Opaque cursor string for pagination\n        direction: Pagination direction - \"older\" (default) or \"newer\"\n        parent_tool_use_id: Filter messages by parent tool use ID (for subagent context)\n\n    Returns:\n        ListMessagesV2Response with UIMessages and pagination info",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "messages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "50"
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "direction",
                  "value": "older"
                },
                {
                  "disabled": false,
                  "key": "parent_tool_use_id",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "task_id",
                  "value": "<string>",
                  "description": "(Required) The task ID"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
