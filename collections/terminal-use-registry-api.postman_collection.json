          "id": "0a855ee5-aad2-417b-b662-ed0f5daeb08b",
          "name": "Get registry credentials for pushing agent images",
          "request": {
            "name": "Get registry credentials for pushing agent images",
            "description": {
              "content": "Get short-lived credentials for pushing images to a namespace's registry.\n\n    Each namespace has its own isolated registry repository. The token returned\n    can ONLY push images to the specified namespace's repository.\n\n    The CLI uses this endpoint to authenticate with Docker before pushing\n    agent images. Returns a token valid for approximately 1 hour.\n\n    **Usage with Docker:**\n    ```bash\n    docker login {registry_url} -u {username} -p {token}\n    docker push {registry_url}/{repository}/{agent}:{tag}\n    ```",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "registry",
                "auth"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "namespace",
                  "value": "<string>",
                  "description": "(Required) Target namespace slug for the image push"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "0e7558fe-8ca8-49bc-bfcb-14938384d30c",
