              {
                "name": "agent_name",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an agent by namespace slug and agent name."
        },
        {
          "info": {
            "name": "Get Agent by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/agents/:agent_id",
            "params": [
              {
